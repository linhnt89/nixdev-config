# .envrc — develop this repository with direnv/nix-direnv.
#
# Requires direnv with nix-direnv installed; both are provided by every
# devShell in this flake (bootstrap with `nix develop` once if you don't
# have them yet).
if ! has nix_direnv_version || ! nix_direnv_version 3; then
  source_url "https://raw.githubusercontent.com/nix-community/nix-direnv/3.1.2/direnvrc" "sha256-Di03ad3a0ueGi6CGrfhrQzyGdQIg9APXIPCAMNQgWYM="
fi
use flake